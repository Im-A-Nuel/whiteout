# Copy to .env (git ignores .env). Foundry reads .env from this folder automatically.
# Never put a private key or mnemonic here. The deployer key lives in a Foundry keystore:
#   cast wallet import deployer --interactive

# RPC endpoint for Sepolia. The public node works for a deploy but is rate limited.
# For steadier runs use your own provider URL (Infura, Alchemy, ...).
SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Needed only for `--verify` on Etherscan. Create a free key at https://etherscan.io/myapikey
ETHERSCAN_API_KEY=
